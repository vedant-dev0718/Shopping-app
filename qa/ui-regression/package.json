        "capture:seller:current": "bash scripts/run-seller-checkpoints.sh current",
        "capture:seller:baseline": "bash scripts/run-seller-checkpoints.sh baseline",
        "capture:seller:e2e:current": "bash scripts/run-seller-e2e-flow.sh current",
        "capture:seller:e2e:baseline": "bash scripts/run-seller-e2e-flow.sh baseline",
        "capture:buyer:e2e:current": "bash scripts/run-buyer-e2e-flow.sh current",
        "capture:buyer:e2e:baseline": "bash scripts/run-buyer-e2e-flow.sh baseline",
        "capture:buyer:ios:accepted-bid:current": "bash scripts/run-buyer-ios-accepted-bid-flow.sh current",

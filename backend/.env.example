# =============================================================================
# NotWhat backend — environment template
# -----------------------------------------------------------------------------
# 1. Copy this file:            cp .env.example .env
# 2. Fill in the values below.  The app runs locally with only the CORE +
#    DATABASE + AUTH sections filled in; everything else is for a specific
#    integration (payments, uploads, email, shipping, admin).
# 3. `.env` is git-ignored — never commit real secrets.
#
# Legend:  [required]  must be set    [dev-optional] safe to leave blank locally
#          Defaults shown in (parentheses) are what the code falls back to.
# Source of truth for every variable: src/config/env.js
# =============================================================================


# ---- CORE / SERVER ----------------------------------------------------------
NODE_ENV=development          # development | production | test
PORT=5001                     # (5001) HTTP port the API listens on


# ---- DATABASE ---------------------------------------------------------------
# [required] MongoDB connection string. Local default shown; use an Atlas URI
# in production.
MONGO_URI=mongodb://127.0.0.1:27017/notwhat


# ---- AUTH (JWT) -------------------------------------------------------------
# [required in production] Secret used to sign login tokens. Use a long random
# string, e.g.  openssl rand -hex 32
JWT_SECRET=replace-with-a-secure-secret
JWT_EXPIRES_IN=7d             # (7d) token lifetime — e.g. 1d, 7d, 30d

# [required in production] Allowed CORS origin for the API (your web frontend).
CLIENT_URL=http://localhost:3000


# ---- GOOGLE SIGN-IN ---------------------------------------------------------
# [dev-optional] From Google Cloud Console -> Credentials -> OAuth client IDs.
# The backend verifies Google ID tokens against these; the iOS app uses the iOS
# client ID. Leave blank to disable Google login.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=


# ---- EMAIL ------------------------------------------------------------------
# Two email backends are supported. Resend is preferred; SMTP is the fallback.
#
# Option A — Resend (recommended): https://resend.com -> API Keys
RESEND_API_KEY=
# From address shown on outgoing mail (both backends use this).
EMAIL_FROM=NotWhat <noreply@notwhat.in>
#
# Option B — SMTP (SendGrid, AWS SES, Gmail for dev, etc.). Only needed if you
# are NOT using Resend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
#
# If neither backend is configured, emails are skipped silently and the flow
# (signup OTP, order confirmation) still succeeds.


# ---- SIGNUP / PASSWORD-RESET OTP --------------------------------------------
# One-time codes emailed during signup and password reset. Defaults are fine
# for local dev.
SIGNUP_OTP_TTL_MINUTES=10        # (10) how long a code stays valid
SIGNUP_OTP_RESEND_SECONDS=60     # (60) cooldown before a new code can be sent
SIGNUP_OTP_MAX_ATTEMPTS=5        # (5)  wrong-code tries before lockout
SIGNUP_OTP_MAX_SENDS=5           # (5)  codes that can be sent per signup
# Fixed OTP that always works in dev/test so you can sign up without real email.
# Only honoured when NODE_ENV is development or test. Leave blank in production.
SIGNUP_OTP_TEST_CODE=
PASSWORD_RESET_OTP_TEST_CODE=


# ---- UPLOADS (AWS S3 preferred) ---------------------------------------------
# [dev-optional] Configure AWS S3 for real image/video uploads via /api/uploads/*.
# If these are missing, the backend can still fall back to Cloudinary (below).
AWS_REGION=
AWS_S3_BUCKET=
# Optional for S3-compatible providers (Cloudflare R2, MinIO, DigitalOcean Spaces).
AWS_S3_ENDPOINT=
# Optional public URL override (for CloudFront/custom CDN), e.g. https://cdn.notwhat.in
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- UPLOADS (Cloudinary fallback) ------------------------------------------
# [dev-optional] Used only when AWS S3 variables above are not configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ---- PAYMENTS (Razorpay) ----------------------------------------------------
# [dev-optional] Razorpay dashboard -> Settings -> API Keys. Test keys work
# end-to-end in development. Without these, checkout fails at payment start.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard -> Settings -> Webhooks -> Secret.
RAZORPAY_WEBHOOK_SECRET=
#
# Advanced payment behaviour (all default to off / safe values):
RAZORPAY_ENABLE_LIVE_REFUNDS=false              # (false) actually call Razorpay refund API
RAZORPAY_CAPTURE_AFTER_SELLER_ACCEPTANCE=false  # (false) authorize now, capture after seller accepts
RAZORPAY_MANUAL_CAPTURE_ENABLED=false           # (false) hold funds until manual capture
RAZORPAY_AUTHORIZATION_TIMEOUT_MINUTES=240      # (240) void an authorized-but-uncaptured payment after this


# ---- SHIPPING (Shiprocket) --------------------------------------------------
# [dev-optional] Shiprocket account login used to fetch a Shiprocket API token.
# Needed only for live label/pickup features. Update the password before going live.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_ENABLE_LIVE_PICKUP_SYNC=false    # (false) push pickup addresses to Shiprocket for real
SHIPROCKET_WEBHOOK_SECRET=                  # verifies incoming Shiprocket tracking webhooks (required in production)


# ---- COMMISSION & ORDER TIMING ----------------------------------------------
PLATFORM_COMMISSION_PERCENTAGE=10     # (10) platform cut taken from each order
SELLER_ACCEPTANCE_WINDOW_MINUTES=240  # (240) time a seller has to accept an order
BID_ACCEPTANCE_WINDOW_MINUTES=240     # (240) time to accept a winning Bargain Day bid


# ---- ADMIN ACCOUNT ----------------------------------------------------------
# Seeded by `npm run seed:admin`. If ADMIN_TOTP_SECRET is blank, that script
# generates one and prints a Google Authenticator setup URL for 2FA login.
ADMIN_EMAIL=admin@notwhat.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=NotWhat Admin
ADMIN_OVERWRITE_PASSWORD=false        # (false) set true to reset the password on re-seed
ADMIN_TOTP_SECRET=

[Unit]
Description=NotWhat API
Documentation=https://github.com/vedant-dev0718/Shopping-app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notwhat
Group=notwhat
WorkingDirectory=/opt/notwhat/app/backend

# Refresh .env from SSM Parameter Store on every start.
ExecStartPre=/opt/notwhat/render-env.sh
ExecStart=/usr/bin/node src/server.js

Restart=always
RestartSec=5

# src/server.js installs a SIGTERM handler that closes the HTTP server and the
# Mongoose connection before exiting; give it room to finish in-flight uploads.
KillSignal=SIGTERM
TimeoutStopSec=30

Environment=NODE_ENV=production
Environment=AWS_REGION=us-east-2

StandardOutput=journal
StandardError=journal
SyslogIdentifier=notwhat-api

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/notwhat/app/backend

[Install]
WantedBy=multi-user.target
